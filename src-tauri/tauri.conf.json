{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeppBridge",
  "version": "2.1.0",
  "identifier": "com.zeppbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run icons:generate && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeppBridge",
        "width": 1280,
        "height": 800,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NTgyOTc0RjI1MThDRTkKUldUcGpGSHlkQ2xZOUE3c3B3RlRFbWM3QVc5YktiMUh4K3pobFdSZHpEUGh6NDVSMWl3TnpTMzEK",
      "endpoints": [
        "https://github.com/lingcang728/ZeppBridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Local-first Zepp health data bridge",
    "longDescription": "ZeppBridge is a local-first desktop companion for syncing and exploring Zepp wearable health data.",
    "copyright": "Copyright © 2026 ZeppBridge contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["dbus-libs", "libayatana-appindicator3"]
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English", "SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
