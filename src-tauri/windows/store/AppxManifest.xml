<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity
    Name="LincStudio.ZeppBridge"
    Publisher="CN=4670A0D8-769F-495D-9030-60FBE54AF9D2"
    Version="3.1.3.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>ZeppBridge</DisplayName>
    <PublisherDisplayName>Linc Studio</PublisherDisplayName>
    <Description>Local-first Zepp health data bridge</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="ZeppBridge" Executable="ZeppBridge.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ZeppBridge"
        Description="Local-first Zepp health data bridge"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
    <Application Id="ZeppBridgeCli" Executable="zeppbridge-cli.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ZeppBridge CLI"
        Description="ZeppBridge command-line tool"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="zeppbridge-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="zeppbridge-cli.exe" />
            <desktop:ExecutionAlias Alias="zeppbridge-store-cli.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
    <Application Id="ZeppBridgeMcp" Executable="zeppbridge-mcp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ZeppBridge MCP"
        Description="ZeppBridge MCP server"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="zeppbridge-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="zeppbridge-mcp.exe" />
            <desktop:ExecutionAlias Alias="zeppbridge-store-mcp.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
